<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
        x:Class="CrossPlatformPasswordManager.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cross-Platform Password Manager"
        Width="800" Height="600"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid RowDefinitions="Auto, *">
        <!-- Debug Timer Display Banner -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10">
            <TextBlock Text="{Binding TimeRemainingText}" 
                       Foreground="Yellow" 
                       HorizontalAlignment="Center" 
                       FontWeight="Bold" 
                       FontSize="16" />
        </Border>

        <!-- Main View Host -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
