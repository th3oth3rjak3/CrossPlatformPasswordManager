<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             x:Class="CrossPlatformPasswordManager.UI.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">

    <!-- Reusable Semi Confirmation Dialog Box -->
    <Border Width="400"
            Padding="24"
            CornerRadius="12"
            Theme="{StaticResource CardBorder}"
            Background="{DynamicResource SystemAltHighColor}">

        <StackPanel Spacing="16">
            
            <TextBlock Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="Bold" />

            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="13" />

            <!-- Dialog Action Buttons -->
            <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Content="{Binding CancelButtonText}"
                        Classes="Tertiary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,6,0" />

                <!-- Dynamic Class Toggles for Danger / Warning / Primary -->
                <Button Grid.Column="1"
                        Content="{Binding ConfirmButtonText}"
                        Classes="Solid"
                        Classes.Danger="{Binding IsDanger}"
                        Classes.Warning="{Binding IsWarning}"
                        Classes.Primary="{Binding IsPrimary}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ConfirmCommand}"
                        Margin="6,0,0,0" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
