<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             x:Class="CrossPlatformPasswordManager.UI.Views.PasswordEditorView"
             x:DataType="vm:PasswordEditorViewModel">

    <!-- Semi Card Dialog Box -->
    <Border Width="400"
            Padding="24"
            CornerRadius="12"
            Theme="{StaticResource CardBorder}"
            Background="{DynamicResource SystemAltHighColor}">

        <StackPanel Spacing="16">
            
            <TextBlock Text="Add Password Entry"
                       FontSize="18"
                       FontWeight="Bold" />

            <!-- Site Name -->
            <StackPanel Spacing="6">
                <TextBlock Text="Site / App Name" FontWeight="SemiBold" FontSize="13" />
                <TextBox Text="{Binding SiteName}" PlaceholderText="e.g. GitHub, Netflix" />
            </StackPanel>

            <!-- Username -->
            <StackPanel Spacing="6">
                <TextBlock Text="Username / Email" FontWeight="SemiBold" FontSize="13" />
                <TextBox Text="{Binding Username}" PlaceholderText="e.g. user@example.com" />
            </StackPanel>

            <!-- Password Field with Reveal Eye Button -->
            <StackPanel Spacing="6">
                <TextBlock Text="Password" FontWeight="SemiBold" FontSize="13" />
    
                <TextBox PasswordChar="●" 
                            Classes="revealPasswordButton"
                            PlaceholderText="Enter password" 
                            Text="{Binding Password}" />
            </StackPanel>

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource SemiColorDanger}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" />

            <!-- Dialog Buttons -->
            <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Content="Cancel"
                        Classes="Tertiary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,6,0" />

                <Button Grid.Column="1"
                        Content="Save Entry"
                        Classes="Primary Solid"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding SaveCommand}"
                        Margin="6,0,0,0" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
