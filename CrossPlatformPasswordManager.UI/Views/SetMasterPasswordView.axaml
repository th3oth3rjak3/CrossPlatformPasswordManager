<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             x:Class="CrossPlatformPasswordManager.UI.Views.SetMasterPasswordView"
             x:DataType="vm:SetMasterPasswordViewModel">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Semi Card Container -->
        <Border Width="420"
                Padding="32"
                CornerRadius="12"
                Theme="{StaticResource CardBorder}">

            <StackPanel Spacing="20">

                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Set Master Password"
                               FontSize="22"
                               FontWeight="Bold" />

                    <TextBlock Text="Your master password protects your entire vault. Keep it safe."
                               FontSize="13"
                               Theme="{StaticResource SecondaryTextBlock}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Master Password Input -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Master Password"
                               FontWeight="SemiBold"
                               FontSize="13" />

                    <TextBox PasswordChar="●"
                             Classes="clearButton"
                             PlaceholderText="Enter your master password"
                             Text="{Binding MasterPassword}" />
                </StackPanel>

                <!-- Confirm Password Input -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Confirm Password"
                               FontWeight="SemiBold"
                               FontSize="13" />

                    <TextBox PasswordChar="●"
                             Classes="clearButton"
                             PlaceholderText="Confirm your master password"
                             Text="{Binding ConfirmPassword}" />
                </StackPanel>

                <!-- Validation Error Message -->
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource SemiColorDanger}"
                           IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <!-- Submit Button -->
                <Button Content="Set Master Password"
                        Classes="Primary Solid"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding SetMasterPasswordCommand}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
