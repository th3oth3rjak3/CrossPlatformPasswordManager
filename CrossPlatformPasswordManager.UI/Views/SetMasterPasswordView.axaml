<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
    x:Class="CrossPlatformPasswordManager.UI.Views.SetMasterPasswordView"
    x:DataType="vm:SetMasterPasswordViewModel">

    <Grid
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <Border
            MinWidth="400"
            MaxWidth="500"
            Padding="40"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

            <StackPanel Spacing="20">

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Create your master password"
                        FontSize="26"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Classes="secondary"
                        Text="Your master password protects your entire vault."
                        FontSize="14"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Master Password"
                        FontWeight="SemiBold" />

                    <TextBox
                        PasswordChar="●"
                        PlaceholderText="Enter your master password"
                        Text="{Binding MasterPassword}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Confirm Password"
                        FontWeight="SemiBold" />

                    <TextBox
                        PasswordChar="●"
                        PlaceholderText="Enter your master password again"
                        Text="{Binding ConfirmPassword}" />
                </StackPanel>

                <TextBlock
                    Classes="error"
                    Text="{Binding ValidationMessage}"
                    TextWrapping="Wrap" />

                <Button
                    Classes="primary"
                    Content="Create Master Password"
                    Command="{Binding SetMasterPasswordCommand}" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>