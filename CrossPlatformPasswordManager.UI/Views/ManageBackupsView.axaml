<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             xmlns:controls="using:CrossPlatformPasswordManager.UI.Controls"
             x:Class="CrossPlatformPasswordManager.UI.Views.ManageBackupsView"
             x:DataType="vm:ManageBackupsViewModel">

    <Grid>
        <!-- Main Content Area -->
        <Grid RowDefinitions="Auto, Auto, *">

            <!-- Action Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0"
                           Text="Database Backups"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <controls:IconButton Grid.Column="1"
                                     Icon="Add" 
                                     Text="Create Manual Backup" 
                                     ButtonClass="Primary Solid" 
                                     Command="{Binding CreateBackupCommand}" />
            </Grid>

            <!-- Backups DataGrid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Backups}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="48"
                      GridLinesVisibility="All">

                <DataGrid.Styles>
                    <Style Selector="DataGridCell">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.Styles>

                <DataGrid.Columns>
                    <!-- File Name Column -->
                    <DataGridTextColumn Header="Backup File" 
                                        Binding="{Binding FileName}" 
                                        Width="2.5*" />

                    <!-- Date Created Column -->
                    <DataGridTextColumn Header="Created At" 
                                        Binding="{Binding CreatedAt, StringFormat=\{0:g\}}" 
                                        Width="1.5*" />

                    <!-- File Size Column -->
                    <DataGridTextColumn Header="Size" 
                                        Binding="{Binding FormattedSize}" 
                                        Width="0.6*" />

                    <!-- Action Column -->
                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Actions" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" 
                                            Spacing="6" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                    
                                    <controls:IconButton Icon="Restore" 
                                                         ButtonClass="Tertiary"
                                                         Padding="6,4"
                                                         ToolTip="Restore Database from this backup"
                                                         Command="{Binding RestoreCommand}" />

                                    <controls:IconButton Icon="Delete"
                                                         ButtonClass="Danger Tertiary"
                                                         Padding="6,4"
                                                         ToolTip="Delete this backup file"
                                                         Command="{Binding DeleteCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- Modal Overlay Layer -->
        <Grid Background="#80000000"
              IsVisible="{Binding ActiveOverlay, Converter={x:Static ObjectConverters.IsNotNull}}"
              IsHitTestVisible="{Binding ActiveOverlay, Converter={x:Static ObjectConverters.IsNotNull}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <ContentControl Content="{Binding ActiveOverlay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
