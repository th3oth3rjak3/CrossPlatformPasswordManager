<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             x:Class="CrossPlatformPasswordManager.UI.Views.VaultView"
             xmlns:controls="using:CrossPlatformPasswordManager.UI.Controls"
             xmlns:models="using:CrossPlatformPasswordManager.UI.Models"
             x:DataType="vm:VaultViewModel">

    <SplitView IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="220">
        <!-- Left Sidebar Navigation Pane -->
        <SplitView.Pane>
            <Grid RowDefinitions="Auto, *, Auto"
                  Background="{DynamicResource SystemAltHighColor}">
                
                <!-- Sidebar Header -->
                <TextBlock Grid.Row="0"
                           Text="Vault"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="16,20,16,16" />

                <!-- Primary Navigation Options -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="8,0">
                    <controls:NavigationItem Icon="Key" 
                                             Text="All Passwords" 
                                             Command="{Binding ShowAllPasswordsCommand}"
                                             ButtonClass="Tertiary" />
                    
                    <controls:NavigationItem Icon="Save" 
                                             Text="Manage Backups" 
                                             Command="{Binding ShowManageBackupsCommand}"
                                             ButtonClass="Tertiary" />
                    
                    <controls:NavigationItem Icon="LockWithKey" 
                                             Text="Change Password" 
                                             Command="{Binding ShowChangeMasterPasswordCommand}"
                                             ButtonClass="Tertiary" />
                </StackPanel>

                <!-- Logout / Lock Vault Action -->
                <StackPanel Grid.Row="2" Margin="8,16">
                    <controls:NavigationItem Icon="{x:Static models:AppIcon.Lock}"
                                             Text="Logout"
                                             Command="{Binding LockVaultCommand}"
                                             ButtonClass="Danger Solid" />
                </StackPanel>
            </Grid>
        </SplitView.Pane>

        <!-- Right Main Sub-Page Content Area -->
        <SplitView.Content>
            <Border Padding="20">
                <ContentControl Content="{Binding CurrentSubPage}" />
            </Border>
        </SplitView.Content>
    </SplitView>
</UserControl>
