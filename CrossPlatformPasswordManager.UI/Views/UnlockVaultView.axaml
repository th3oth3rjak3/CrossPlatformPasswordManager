<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             x:Class="CrossPlatformPasswordManager.UI.Views.UnlockVaultView"
             x:DataType="vm:UnlockVaultViewModel">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Semi Card Container -->
        <Border Width="420"
                Padding="32"
                CornerRadius="12"
                Theme="{StaticResource CardBorder}">

            <StackPanel Spacing="20">

                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Unlock Vault"
                               FontSize="22"
                               FontWeight="Bold" />

                    <TextBlock Text="Enter your master password to unlock your vault."
                               FontSize="13"
                               Theme="{StaticResource SecondaryTextBlock}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Password Input -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Master Password"
                               FontWeight="SemiBold"
                               FontSize="13" />

                    <TextBox PasswordChar="●"
                             Classes="clearButton"
                             PlaceholderText="Enter your master password"
                             Text="{Binding MasterPassword}" />
                </StackPanel>

                <!-- Validation Error Message -->
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource SemiColorDanger}"
                           IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"
                           FontSize="13" />

                <!-- Submit Button -->
                <Button Content="Unlock Vault"
                        Classes="Primary Solid"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding UnlockVaultCommand}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
