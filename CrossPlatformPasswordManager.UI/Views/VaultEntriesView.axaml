<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             xmlns:controls="using:CrossPlatformPasswordManager.UI.Controls"
             xmlns:models="using:CrossPlatformPasswordManager.UI.Models"
             x:Class="CrossPlatformPasswordManager.UI.Views.VaultEntriesView"
             x:DataType="vm:VaultEntriesViewModel">

    <Grid>
        <!-- Main Content Area (Search Bar + DataGrid) -->
        <Grid RowDefinitions="Auto, *">

            <!-- Search & Add Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                <TextBox Grid.Column="0"
                         Classes="clearButton"
                         Width="320"
                         PlaceholderText="Search passwords..."
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         HorizontalAlignment="Left" />

                <controls:IconButton Grid.Column="2" 
                                     Icon="Add" 
                                     Text="Add Password" 
                                     ButtonClass="Primary Solid" 
                                     Command="{Binding AddPasswordCommand}" />
            </Grid>

            <!-- DataGrid with Row ContextMenu -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="44"
                      GridLinesVisibility="All">
                <DataGrid.Styles>
                    <Style Selector="DataGridRow">
                        <Setter Property="ContextMenu">
                            <ContextMenu x:DataType="vm:PasswordEntryDisplayItem">

                                <MenuItem Command="{Binding CopyUsernameCommand}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Static models:AppIcons.User}"
                                                FontFamily="NotoEmoji" />
                                            <TextBlock Text="Copy Username" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Command="{Binding CopyPasswordCommand}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Static models:AppIcons.Copy}"
                                                FontFamily="NotoEmoji" />
                                            <TextBlock Text="Copy Password" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Command="{Binding ToggleShowPasswordCommand}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Static models:AppIcons.Eye}"
                                                FontFamily="NotoEmoji" />
                                            <TextBlock Text="Toggle Show / Hide Password" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <Separator />

                                <MenuItem Command="{Binding EditCommand}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Static models:AppIcons.Edit}"
                                                FontFamily="NotoEmoji" />
                                            <TextBlock Text="Edit Entry" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem
                                    Foreground="{DynamicResource SemiColorDanger}"
                                    Command="{Binding DeleteCommand}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Static models:AppIcons.Delete}"
                                                FontFamily="NotoEmoji" />
                                            <TextBlock Text="Delete Entry" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                            </ContextMenu>
                        </Setter>
                    </Style>
                </DataGrid.Styles>

                <DataGrid.Columns>
                    <!-- Site Column -->
                    <DataGridTextColumn Header="Site / App" 
                                        Binding="{Binding SiteName}" 
                                        Width="1.5*" />

                    <!-- Username Column -->
                    <DataGridTextColumn Header="Username" 
                                        Binding="{Binding Username}" 
                                        Width="2*" />

                    <!-- Password Text Column -->
                    <DataGridTemplateColumn Header="Password" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayPassword}" 
                                           VerticalAlignment="Center" 
                                           FontFamily="NotoEmoji, Consolas, Monospace" 
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Dedicated Action Buttons Column -->
                    <DataGridTemplateColumn Width="Auto">
                        <!-- Centered Header Template -->
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Actions" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <controls:IconButton Icon="Eye"
                                                         ButtonClass="Tertiary"
                                                         Padding="6,4"
                                                         ToolTip="Toggle Show/Hide"
                                                         Command="{Binding ToggleShowPasswordCommand}" />

                                    <controls:IconButton Icon="Copy"
                                                         ButtonClass="Tertiary"
                                                         Padding="6,4"
                                                         ToolTip="Copy Password"
                                                         Command="{Binding CopyPasswordCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- Modal Overlay Layer -->
        <Grid Background="#80000000"
              IsVisible="{Binding ActiveEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
              IsHitTestVisible="{Binding ActiveEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <ContentControl Content="{Binding ActiveEditor}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
