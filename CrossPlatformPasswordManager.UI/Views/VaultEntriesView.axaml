<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             x:Class="CrossPlatformPasswordManager.UI.Views.VaultEntriesView"
             x:DataType="vm:VaultEntriesViewModel">

    <Grid>
        <!-- Main Content Area (Search Bar + DataGrid) -->
        <Grid RowDefinitions="Auto, *">

            <!-- Search & Add Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                <TextBox Grid.Column="0"
                         Classes="clearButton"
                         Width="320"
                         PlaceholderText="🔍 Search passwords..."
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         HorizontalAlignment="Left" />

                <Button Grid.Column="2"
                        Content="➕ Add Password"
                        Classes="Primary Solid"
                        Command="{Binding AddPasswordCommand}" />
            </Grid>

            <!-- DataGrid with Row ContextMenu -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="44"
                      GridLinesVisibility="All">

                <!-- Right-Click Context Menu for Rows -->
                <DataGrid.Styles>
                    <Style Selector="DataGridRow">
                        <Setter Property="ContextMenu">
                            <ContextMenu x:DataType="vm:PasswordEntryDisplayItem">
                                <MenuItem Header="👤 Copy Username"
                                          Command="{Binding CopyUsernameCommand}" />

                                <MenuItem Header="📋 Copy Password"
                                          Command="{Binding CopyPasswordCommand}" />
                
                                <MenuItem Header="👁 Toggle Show / Hide Password"
                                          Command="{Binding ToggleShowPasswordCommand}" />

                                <Separator />

                                <MenuItem Header="✏️ Edit Entry"
                                          Command="{Binding EditCommand}" />

                                <MenuItem Header="🗑️ Delete Entry"
                                          Foreground="{DynamicResource SemiColorDanger}"
                                          Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </Setter>
                    </Style>
                </DataGrid.Styles>

                <DataGrid.Columns>
                    <!-- Site Column -->
                    <DataGridTextColumn Header="Site / App" 
                                        Binding="{Binding SiteName}" 
                                        Width="1.5*" />

                    <!-- Username Column -->
                    <DataGridTextColumn Header="Username" 
                                        Binding="{Binding Username}" 
                                        Width="2*" />

                    <!-- Password Text Column -->
                    <DataGridTemplateColumn Header="Password" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayPassword}" 
                                           VerticalAlignment="Center" 
                                           FontFamily="Consolas, Monospace" 
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Dedicated Action Buttons Column -->
                    <DataGridTemplateColumn Width="Auto">
                        <!-- Centered Header Template -->
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Actions" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Content="👁"
                                            Classes="Tertiary"
                                            Padding="6,4"
                                            ToolTip.Tip="Toggle Show/Hide"
                                            Command="{Binding ToggleShowPasswordCommand}" />

                                    <Button Content="📋"
                                            Classes="Tertiary"
                                            Padding="6,4"
                                            ToolTip.Tip="Copy Password"
                                            Command="{Binding CopyPasswordCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- Modal Overlay Layer -->
        <Grid Background="#80000000"
              IsVisible="{Binding ActiveEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
              IsHitTestVisible="{Binding ActiveEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <ContentControl Content="{Binding ActiveEditor}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
