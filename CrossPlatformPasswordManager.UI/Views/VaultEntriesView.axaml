<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
             x:Class="CrossPlatformPasswordManager.UI.Views.VaultEntriesView"
             x:DataType="vm:VaultEntriesViewModel">

    <Grid RowDefinitions="Auto, *">

        <!-- Search & Add Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
    
            <!-- Search Bar with Fixed Width -->
            <TextBox Grid.Column="0"
                     Width="320"
                     PlaceholderText="🔍 Search passwords..."
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     HorizontalAlignment="Left" />

            <!-- Add Password Button -->
            <Button Grid.Column="2"
                    Content="➕ Add Password"
                    Classes="Primary Solid"
                    Command="{Binding AddPasswordCommand}" />
        </Grid>

        <!-- Passwords DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <!-- Site Name Column -->
                <DataGridTextColumn Header="Site / App" 
                                    Binding="{Binding SiteName}" 
                                    Width="1.5*" />

                <!-- Username Column -->
                <DataGridTextColumn Header="Username" 
                                    Binding="{Binding Username}" 
                                    Width="2*" />

                <!-- Password Column with Inline Actions -->
                <DataGridTemplateColumn Header="Password" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayPassword}" 
                                           VerticalAlignment="Center" 
                                           FontFamily="Consolas, Monospace" />

                                <Button Content="👁"
                                        Classes="Tertiary"
                                        Padding="4,2"
                                        Command="{Binding ToggleShowPasswordCommand}" />

                                <Button Content="📋"
                                        Classes="Tertiary"
                                        Padding="4,2"
                                        Command="{Binding CopyPasswordCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions Column -->
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="✏️ Edit"
                                        Classes="Tertiary"
                                        Command="{Binding $parent[UserControl].((vm:VaultEntriesViewModel)DataContext).EditPasswordCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Content="🗑️ Delete"
                                        Classes="Danger Tertiary"
                                        Command="{Binding $parent[UserControl].((vm:VaultEntriesViewModel)DataContext).DeletePasswordCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
