<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CrossPlatformPasswordManager.UI.ViewModels"
    xmlns:views="using:CrossPlatformPasswordManager.UI.Views"
    x:Class="CrossPlatformPasswordManager.UI.App">

    <!-- Global ViewModel-to-View mappings -->
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:SetMasterPasswordViewModel}">
            <views:SetMasterPasswordView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UnlockVaultViewModel}">
            <views:UnlockVaultView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VaultViewModel}">
            <views:VaultView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VaultEntriesViewModel}">
            <views:VaultEntriesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ManageBackupsViewModel}">
            <views:ManageBackupsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StartupErrorViewModel}">
            <views:StartupErrorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PasswordEditorViewModel}">
            <views:PasswordEditorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
            <views:ConfirmDialogView />
        </DataTemplate>

    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme />
        <semi:DataGridSemiTheme />
    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="NotoEmoji">
            avares://PasswordManager/Assets/#Noto Color Emoji
        </FontFamily>
    </Application.Resources>
    
</Application>