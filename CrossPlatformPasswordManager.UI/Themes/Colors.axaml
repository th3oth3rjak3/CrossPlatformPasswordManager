<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#17151A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#211E25" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#29252E" />
    <SolidColorBrush x:Key="InputBrush" Color="#151319" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#39343F" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#8F7AA8" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E8E3EA" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAA2B0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#746D78" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#9B82B5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#AC91C7" />

    <!-- Error -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#D97878" />

</ResourceDictionary>